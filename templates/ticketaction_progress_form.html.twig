{% extends 'components/itilobject/timeline/form_timeline_item.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block timeline_card %}
    <div class="security-incident card mt-4">
        <form name="security_incident_progress_form" id="security_incident_progress_form_{{ rand }}"
              class="d-flex flex-column bg-white" method="post"
              action="{{ action }}"
              enctype="multipart/form-data"
              data-track-changes="true" data-submit-once>

            <input type="hidden" name="tickets_id" value="{{ ticket.getID() }}" />
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />

            <div class="card-header">
                <div>
                    <h3 class="card-title mb-1">{{ __('Incidente de Seguridad', 'socsecincident') }}</h3>
                    <div class="text-muted small">
                        {{ __('Estado actual', 'socsecincident') }}: <strong>{{ current_state }}</strong>
                    </div>
                </div>
            </div>
            <div class="card-body">
                {% if next_stages is empty %}
                    <p class="text-muted mb-0">{{ __('No hay más estados a los que avanzar.', 'socsecincident') }}</p>
                {% else %}
                    {% set stage_options = {'': '-- ' ~ __('Selecciona el siguiente estado', 'socsecincident') ~ ' --'} %}
                    {% for stage in next_stages %}
                        {% set stage_options = stage_options|merge({(stage): stage}) %}
                    {% endfor %}
                    {{ fields.dropdownArrayField(
                        'new_state',
                        '',
                        stage_options,
                        __('Siguiente estado', 'socsecincident'),
                        {
                            'full_width': true,
                            'required': true,
                            'label': true,
                            'rand': rand,
                            'on_change': 'socsecincident_toggle_final_classification' ~ rand ~ '(this.value)',
                        }
                    ) }}

                    {# Only relevant when advancing straight to "Cerrado": the initial
                       classification chosen on declare may no longer hold, so ask again
                       — restricted to the two final answers, no "Pendiente Veredicto". #}
                    <div class="form-field col-12 mt-2" id="socsecincident_final_classification_{{ rand }}" style="display:none;">
                        {{ fields.dropdownArrayField(
                            'final_classification',
                            '',
                            {
                                '': '-- ' ~ __('Selecciona la clasificación final', 'socsecincident') ~ ' --',
                                'materialized': __('Materializado', 'socsecincident'),
                                'not_materialized': __('No materializado', 'socsecincident'),
                            },
                            __('Clasificación final', 'socsecincident'),
                            {
                                'full_width': true,
                                'label': true,
                                'rand': rand,
                            }
                        ) }}
                    </div>

                    <div class="form-field col-12 mt-2">
                        {% set fup_template_lbl %}
                            <i class="{{ 'ITILFollowupTemplate'|itemtype_icon }} me-1"
                               title="{{ _n('Followup template', 'Followup templates', get_plural_number()) }}"></i>
                            {{ __('Plantilla de seguimiento', 'socsecincident') }}
                        {% endset %}
                        {{ fields.dropdownField(
                            'ITILFollowupTemplate',
                            'itilfollowuptemplates_id',
                            0,
                            fup_template_lbl,
                            {
                                'full_width': true,
                                'icon_label': true,
                                'on_change': 'socsecincident_progress_template_update' ~ rand ~ '(this.value)',
                                'entity': ticket.fields['entities_id'],
                                'rand': rand,
                            }
                        ) }}
                    </div>

                    {{ fields.textareaField(
                        'comment',
                        '',
                        __('Comment', 'socsecincident'),
                        {
                            'id': 'security_incident_progress_content_' ~ rand,
                            'full_width': true,
                            'required': false,
                            'label': true,
                            'is_horizontal': false,
                            'enable_richtext': true,
                            'enable_fileupload': false,
                            'enable_mentions': true,
                            'entities_id': ticket.fields['entities_id'],
                            'rand': rand,
                        }
                    ) }}
                {% endif %}
            </div>
            {% if next_stages is not empty %}
                <div class="d-flex card-footer justify-content-center">
                    <div class="input-group justify-content-center">
                        <button class="btn btn-primary me-2" type="submit" name="confirm_security_incident_progress">
                            <i class="ti ti-arrow-big-right-lines"></i>
                            <span>{{ _x('button', 'Update') }}</span>
                        </button>
                    </div>
                </div>
            {% endif %}
        </form>
    </div>
    {% if next_stages is not empty %}
    <script>
        function socsecincident_toggle_final_classification{{ rand }}(value) {
            var wrapper = document.getElementById('socsecincident_final_classification_{{ rand }}');
            var select  = document.getElementById('dropdown_final_classification{{ rand }}');
            if (!wrapper) {
                return;
            }
            var is_closing = (value === 'Cerrado');
            wrapper.style.display = is_closing ? '' : 'none';
            if (select) {
                select.required = is_closing;
            }
        }

        function socsecincident_progress_template_update{{ rand }}(value) {
            $.ajax({
                url: `${CFG_GLPI.root_doc}/ajax/itilfollowup.php`,
                type: 'POST',
                data: {
                    itilfollowuptemplates_id: value,
                    items_id: '{{ ticket.getID()|e('js') }}',
                    itemtype: 'Ticket'
                }
            }).done(function (data) {
                if (data.content && data.content.trim() !== '') {
                    setRichTextEditorContent("security_incident_progress_content_{{ rand }}", data.content);
                }
            });
        }
    </script>
    {% endif %}
{% endblock %}
