{% extends 'components/itilobject/timeline/form_timeline_item.html.twig' %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% block timeline_card %}
    <div class="security-incident card mt-4">
        <form name="security_incident_form" id="security_incident_form_{{ rand }}"
              class="d-flex flex-column bg-white" method="post"
              action="{{ action }}"
              enctype="multipart/form-data"
              data-track-changes="true" data-submit-once>

            <input type="hidden" name="tickets_id" value="{{ ticket.getID() }}" />
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}" />

            <div class="card-header">
                <h3 class="card-title">{{ __('Incidente de Seguridad', 'socsecincident') }}</h3>
            </div>
            <div class="card-body">
                {{ fields.textareaField(
                    'comment',
                    '',
                    __('Comment', 'socsecincident'),
                    {
                        'id': 'security_incident_content_' ~ rand,
                        'full_width': true,
                        'required': true,
                        'label': true,
                        'is_horizontal': false,
                        'enable_richtext': true,
                        'enable_fileupload': false,
                        'enable_mentions': true,
                        'entities_id': ticket.fields['entities_id'],
                        'rand': rand,
                    }
                ) }}

                <div class="form-field col-12 mt-2">
                    {% set fup_template_lbl %}
                        <i class="{{ 'ITILFollowupTemplate'|itemtype_icon }} me-1"
                           title="{{ _n('Followup template', 'Followup templates', get_plural_number()) }}"></i>
                        {{ __('Plantilla de seguimiento', 'socsecincident') }}
                    {% endset %}
                    {{ fields.dropdownField(
                        'ITILFollowupTemplate',
                        'itilfollowuptemplates_id',
                        0,
                        fup_template_lbl,
                        {
                            'full_width': true,
                            'icon_label': true,
                            'on_change': 'socsecincident_template_update' ~ rand ~ '(this.value)',
                            'entity': ticket.fields['entities_id'],
                            'rand': rand,
                        }
                    ) }}
                </div>

                <div class="form-field col-12 mt-2">
                    {{ fields.dropdownArrayField(
                        'classification',
                        '',
                        {
                            '': '-- ' ~ __('Selecciona una clasificación', 'socsecincident') ~ ' --',
                            'materialized': __('Materializado', 'socsecincident'),
                            'not_materialized': __('No materializado', 'socsecincident'),
                            'pending_verdict': __('Pendiente Veredicto', 'socsecincident'),
                        },
                        __('Clasificación', 'socsecincident'),
                        {
                            'full_width': true,
                            'required': true,
                            'label': true,
                            'rand': rand,
                        }
                    ) }}
                </div>
            </div>
            <div class="d-flex card-footer justify-content-center">
                <div class="input-group justify-content-center">
                    <button class="btn btn-primary me-2" type="submit" name="confirm_security_incident">
                        <i class="ti ti-plus"></i>
                        <span>{{ _x('button', 'Add') }}</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
    <script>
        function socsecincident_template_update{{ rand }}(value) {
            $.ajax({
                url: `${CFG_GLPI.root_doc}/ajax/itilfollowup.php`,
                type: 'POST',
                data: {
                    itilfollowuptemplates_id: value,
                    items_id: '{{ ticket.getID()|e('js') }}',
                    itemtype: 'Ticket'
                }
            }).done(function (data) {
                if (data.content && data.content.trim() !== '') {
                    setRichTextEditorContent("security_incident_content_{{ rand }}", data.content);
                }
            });
        }
    </script>
{% endblock %}
